{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "CallShield_Phase1/backend",
      "framework": "nestjs",
      "buildCommand": "npm run vercel-build",
      "functions": {
        "src/main.ts": {
          "includeFiles": "{node_modules/**,node_modules/.prisma/client/**}"
        }
      }
    },
    "frontend": {
      "root": "CallShield_Phase1/frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
