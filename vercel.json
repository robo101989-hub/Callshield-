{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix CallShield_Phase1/frontend",
  "buildCommand": "npm run build",
  "outputDirectory": "CallShield_Phase1/frontend/dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://callshield-phase1-api.vercel.app/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
